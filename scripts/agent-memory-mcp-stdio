#!/usr/bin/env bash
# agent-memory-mcp-stdio — launcher for the Sacred Brain MCP server (stdio transport).
#
# Sources ~/.config/hippocampus.env if present so AGENT_MEMORY_* or legacy HIPPOCAMPUS_URL / _API_KEY /
# _USER_ID flow through to the server without per-client duplication.
#
# Usage: add to your MCP client as:
#   claude mcp add sacred-brain /home/<user>/.local/bin/agent-memory-mcp-stdio
# Or in Claude Desktop claude_desktop_config.json:
#   "sacred-brain": { "command": "/home/<user>/.local/bin/agent-memory-mcp-stdio" }
set -euo pipefail

for f in "$HOME/.config/hippocampus.env" "$HOME/.config/agent-memory.env"; do
  if [[ -r "$f" ]]; then
    set -a
    # Runtime-selected env file; ShellCheck cannot resolve the path statically.
    # shellcheck disable=SC1090
    . "$f"
    set +a
    break
  fi
done

# Writes from coding agents land in a dedicated bucket by default so they
# don't pollute the chat-persona scopes (sam/mel). Override per-host by
# exporting SACRED_MCP_DEFAULT_WRITE_USER_ID before invoking the launcher.
: "${SACRED_MCP_DEFAULT_WRITE_USER_ID:=coding_agent}"
export SACRED_MCP_DEFAULT_WRITE_USER_ID

# Prefer an in-tree checkout if present; fall back to the installed package.
# A deployed host has no checkout, so the fallback is the normal path.
REPO="${AGENT_MEMORY_ROOT:-${SACRED_BRAIN_ROOT:-}}"
if [[ -n "$REPO" && -d "$REPO/services/agent_memory_mcp" ]]; then
  cd "$REPO"
fi

exec python3 -m services.agent_memory_mcp.stdio
