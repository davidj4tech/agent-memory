HIPPOCAMPUS_CONFIG=/etc/agent-memory/hippocampus.toml
SAM_DEFAULT_ALIAS=sam-deep
SAM_LLM_BASE_URL=http://127.0.0.1:4000
SAM_LLM_ENABLED=true
SAM_LLM_TIMEOUT=120
HIPPOCAMPUS_API_KEY=CHANGE_ME_hippo_api_key

# Source directory for hippocampus-memory-sync (MEMORY.md and/or memory/*.md).
# Host-specific, so there is no default. The unit is opt-in and skips cleanly
# until this points at a real directory.
#MEMORY_SYNC_ROOT=/srv/notes
