MG_BIND_HOST=0.0.0.0
MG_PORT=54323
HIPPOCAMPUS_URL=http://127.0.0.1:54321
HIPPOCAMPUS_API_KEY=CHANGE_ME_hippo_api_key
LITELLM_BASE_URL=http://127.0.0.1:4000
LITELLM_API_KEY=
# Mirror every /observe event to <state>/stream.log. Not just a debug log: the
# nightly dream's REM reflection reads it for its "input events", so with it
# off the dream sees nothing but oracle events. Keep it on.
MG_STREAM_ENABLE=true
MG_STREAM_TTL_DAYS=14
MG_WORKING_TTL_HOURS=24
MG_ROOMS_SCOPE=room
MG_LOG_ASSISTANT=false
MG_CONSOLIDATE_SCOPES=
MG_RERANK_ENABLE=true
MG_RERANK_MODEL=gpt-4o-mini
MG_RERANK_MAX=10
MG_STATE_DIR=/var/lib/agent-memory/governor
