[Unit]
Description=LiteLLM Proxy via Docker Compose
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

# Skip cleanly (not fail) on a host without docker, or with this stack
# removed from /etc/agent-memory/compose.
ConditionFileIsExecutable=/usr/bin/docker
ConditionPathExists=/etc/agent-memory/compose/litellm/docker-compose.yml

[Service]
Type=oneshot
WorkingDirectory=/etc/agent-memory/compose/litellm
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
RemainAfterExit=yes

[Install]
WantedBy=multi-user.target
