[Unit]
Description=Auto memory tuning for capture gating
After=network.target

[Service]
Type=oneshot
User=agent-memory
Group=agent-memory
Environment=HIPPOCAMPUS_SQLITE_PATH=/var/lib/agent-memory/hippocampus/hippocampus_memories.sqlite
Environment=AUTO_TUNE_PATH=/var/lib/agent-memory/auto_memory_tuning.json
ExecStart=/usr/local/bin/agent-memory-tune

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-memory
ReadOnlyPaths=/opt/pipx
ProtectKernelTunables=true
ProtectKernelModules=true
