[Unit]
Description=Prune auto memories (low-salience) from Hippocampus
After=network.target

[Service]
Type=oneshot
User=agent-memory
Group=agent-memory
EnvironmentFile=/etc/agent-memory/hippocampus.env
Environment=HIPPOCAMPUS_SQLITE_PATH=/var/lib/agent-memory/hippocampus/hippocampus_memories.sqlite
ExecStart=/usr/local/bin/agent-memory-prune

# Hardening (lighter for oneshot)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-memory
ReadOnlyPaths=/opt/pipx /etc/agent-memory
ProtectKernelTunables=true
ProtectKernelModules=true

[Install]
WantedBy=multi-user.target
