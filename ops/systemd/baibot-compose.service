[Unit]
Description=Baibot TTS/STT (docker compose)
Requires=docker.service
After=docker.service network-online.target

# Skip cleanly (not fail) on a host without docker, or with this stack
# removed from /etc/agent-memory/compose.
ConditionFileIsExecutable=/usr/bin/docker
ConditionPathExists=/etc/agent-memory/compose/baibot/docker-compose.yml

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/agent-memory/compose/baibot
ExecStart=/usr/bin/docker compose up -d
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=60
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
