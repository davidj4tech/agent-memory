[Unit]
Description=Memory Governor (Agno + Mem0) service
After=network-online.target litellm-compose.service hippocampus.service
Wants=network-online.target

[Service]
Type=simple
User=agent-memory
Group=agent-memory
EnvironmentFile=/etc/agent-memory/memory-governor.env
# Shared API keys (LITELLM_API_KEY, HIPPOCAMPUS_API_KEY) rendered from the sops
# secrets store; optional (-), loaded second so it wins. No key literals above.
EnvironmentFile=-/etc/agent-memory/secrets.env
ExecStart=/usr/local/bin/memory-governor
Restart=always
RestartSec=3

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-memory
ReadOnlyPaths=/opt/pipx /etc/agent-memory
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
