[Unit]
Description=One-shot post-check of the first nightly agent-memory-dream run(s)
After=agent-memory-dream.timer

[Service]
Type=oneshot
User=agent-memory
Group=agent-memory
ExecStart=/bin/bash -lc '\
  set +e; \
  OUT="/var/lib/agent-memory/dreams/postcheck-$(date -u +%%Y-%%m-%%dT%%H%%M%%SZ).txt"; \
  mkdir -p /var/lib/agent-memory/dreams; \
  { \
    echo "# agent-memory-dream post-check"; \
    echo "generated: $(date -u +%%FT%%TZ)"; \
    echo; \
    echo "## timer status"; \
    systemctl status agent-memory-dream.timer --no-pager -l || true; \
    echo; \
    echo "## service status"; \
    systemctl status agent-memory-dream.service --no-pager -l || true; \
    echo; \
    echo "## journalctl -u agent-memory-dream --since \"3 days ago\""; \
    journalctl -u agent-memory-dream.service --since "3 days ago" --no-pager || true; \
    echo; \
    echo "## ls /var/lib/agent-memory/dreams/"; \
    ls -la /var/lib/agent-memory/dreams/ || true; \
    echo; \
    echo "## latest dream entry (if any)"; \
    LATEST=$(ls -1t /var/lib/agent-memory/dreams/*.md 2>/dev/null | head -1); \
    if [ -n "$LATEST" ]; then \
      echo "--- $LATEST ---"; \
      head -200 "$LATEST"; \
    else \
      echo "(no dream .md files present)"; \
    fi; \
    echo; \
    echo "## dream_promotions (last 7 days)"; \
    DB=/var/lib/agent-memory/memory-governor/state.db; \
    if [ -r "$DB" ]; then \
      sqlite3 "$DB" "SELECT memory_id, datetime(last_dreamed_at, \"unixepoch\") AS last, dream_count, printf(\"%%.3f\", last_score) AS score FROM dream_promotions WHERE last_dreamed_at >= strftime(\"%%s\", \"now\", \"-7 days\") ORDER BY last_dreamed_at DESC LIMIT 50;" || true; \
      echo; \
      echo "-- row count --"; \
      sqlite3 "$DB" "SELECT COUNT(*) FROM dream_promotions;" || true; \
    else \
      echo "(state.db not readable at $DB)"; \
    fi; \
  } > "$OUT" 2>&1; \
  echo "wrote $OUT"; \
  ln -sfn "$(basename "$OUT")" /var/lib/agent-memory/dreams/postcheck-latest.txt; \
'

NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-memory
