[Unit]
Description=Nightly Memory Governor digest to markdown
After=memory-governor.service

[Service]
Type=oneshot
User=agent-memory
Group=agent-memory
Environment=MG_USER_ID=sam
Environment=DIGEST_OUTPUT_DIR=/var/lib/agent-memory/digests
Environment=MG_TZ_OFFSET_HOURS=11
ExecStart=/usr/local/bin/agent-memory-digest

# Hardening (lighter for oneshot)
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-memory/digests
ReadOnlyPaths=/opt/pipx
ProtectKernelTunables=true
ProtectKernelModules=true
