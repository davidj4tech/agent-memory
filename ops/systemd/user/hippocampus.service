[Unit]
Description=agent-memory Hippocampus (memory store, user service)
Documentation=https://github.com/davidj4tech/agent-memory
After=network.target

[Service]
Type=simple
# Secret config (API key + paths) deployed out-of-band; the service stays
# down cleanly until it exists.
EnvironmentFile=%h/.config/agent-memory/hippocampus.env
# Shared secrets rendered from the sops store by dotfiles-secrets; optional (-)
# and loaded second so it wins where keys overlap.
EnvironmentFile=-%h/.config/agent-memory/secrets.env
ExecStart=%h/.local/bin/hippocampus
Restart=on-failure
RestartSec=3
# User-service hardening. NOTE: no User=/Group= and no ProtectHome — the service
# IS the user and needs ~/.config + ~/.local/state.
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
