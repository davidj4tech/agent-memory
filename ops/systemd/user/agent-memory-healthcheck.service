[Unit]
Description=agent-memory healthcheck (dream/consolidation watcher)
After=hippocampus.service memory-governor.service
Wants=hippocampus.service memory-governor.service

[Service]
Type=oneshot
EnvironmentFile=-%h/.config/agent-memory/memory-governor.env
EnvironmentFile=-%h/.config/agent-media/secrets.env
Environment=AGENT_MEMORY_HEALTH_MATRIX=1
Environment=AGENT_MEMORY_HEALTH_WALL=1
ExecStart=%h/.local/bin/agent-memory-healthcheck
