[Unit]
Description=Sacred Brain Memory Governor (policy/recall layer, user service)
Documentation=https://github.com/davidj4tech/sacred-brain
After=network.target hippocampus.service
Wants=hippocampus.service

[Service]
Type=simple
EnvironmentFile=%h/.config/sacred-brain/memory-governor.env
# Secrets (LITELLM_API_KEY, HIPPOCAMPUS_API_KEY) rendered from the sops store by
# dotfiles-secrets; loaded second so it wins, optional (-) so the unit still
# starts if it's absent.
EnvironmentFile=-%h/.config/sacred-brain/secrets.env
ExecStart=%h/.local/bin/memory-governor
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target
