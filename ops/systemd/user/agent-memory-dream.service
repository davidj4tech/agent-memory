[Unit]
Description=agent-memory nightly dreaming sweep (score + promote + REM reflection, user)
After=memory-governor.service hippocampus.service
Requires=memory-governor.service

[Service]
Type=oneshot
EnvironmentFile=%h/.config/agent-memory/memory-governor.env
EnvironmentFile=%h/.config/agent-memory/secrets.env
WorkingDirectory=%h/projects/agent-memory
Environment=PYTHONPATH=%h/projects/agent-memory
ExecStart=/bin/bash -lc 'USERS="$${MG_DREAM_USERS:-sam}"; IFS="," read -ra ITEMS <<< "$USERS"; for u in "$${ITEMS[@]}"; do [ -z "$u" ] && continue; %h/.local/share/pipx/venvs/agent-memory/bin/agent-memory-dream --user-id "$u" --apply --reflect || true; done'
