[Unit]
Description=agent-memory Matrix Auto-Join Helper
After=network.target

# Skip cleanly (not fail) when the host has not configured Matrix.
ConditionPathExists=/etc/agent-memory/matrix.env

[Service]
Type=simple
EnvironmentFile=/etc/agent-memory/matrix.env
ExecStart=/usr/local/bin/agent-memory-matrix-autojoin
User=agent-memory
Group=agent-memory
Restart=on-failure

[Install]
WantedBy=multi-user.target
