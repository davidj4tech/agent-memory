[Unit]
Description=Export Hippocampus memories to Org/Denote
After=hippocampus.service

[Service]
Type=oneshot
User=agent-memory
Group=agent-memory
ExecStart=/usr/local/bin/agent-memory-notes export --dir /var/lib/agent-memory/hippocampus/memories-denote

# Hardening
NoNewPrivileges=true
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ReadWritePaths=/var/lib/agent-memory
ReadOnlyPaths=/opt/pipx
ProtectKernelTunables=true
ProtectKernelModules=true
